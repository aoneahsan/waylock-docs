{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "allowJs": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "strict": true,
    "sourceMap": false,
    "declarationMap": false,
    "inlineSourceMap": false,
    "types": ["node", "@docusaurus/module-type-aliases", "@docusaurus/theme-classic"],
    "paths": {"@site/*": ["./*"]}
  },
  "include": ["docusaurus.config.ts", "sidebars.ts", "src/**/*", "plugins/**/*"]
}
